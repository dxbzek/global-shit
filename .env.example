# World Pulse - server-side keys only. None of these reach the browser.
#
# Local development: copy to `.dev.vars` (wrangler reads that file).
# Production: set each with `npx wrangler secret put <NAME>`.

# -- Required for the market bar -----------------------------------------------
# Oil and gas spot prices from the U.S. Energy Information Administration.
# Free, instant registration: https://www.eia.gov/opendata/register.php
# Without this the market bar shows "No data" and says the key is missing.
EIA_API_KEY=

# -- Optional: conflict datasets -----------------------------------------------
# UCDP used to be open but now requires an access token.
# Register: https://ucdp.uu.se/apidocs/
# Without it, country war/conflict status falls back to the
# two-independent-outlet rule, and no country is ever shown as "At peace"
# (peace needs a dataset's negative evidence, not an absence of reporting).
UCDP_API_TOKEN=

# ACLED, as an optional second conflict dataset.
# Register: https://acleddata.com/data-export-tool/
ACLED_API_KEY=
ACLED_EMAIL=

# -- Optional: globe imagery ---------------------------------------------------
# The globe defaults to Esri World Imagery, which needs no key.
#
# Cesium Ion unlocks Cesium World Imagery and world terrain.
# Free tier: https://ion.cesium.com/signup
CESIUM_ION_TOKEN=

# Google Photorealistic 3D Tiles. Paid, and billed per request.
# Enable "Map Tiles API": https://console.cloud.google.com/apis/library/tile.googleapis.com
GOOGLE_MAPS_API_KEY=
